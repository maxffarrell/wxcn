{
	"name": "wxcn",
	"version": "0.1.0",
	"description": "shadcn-svelte registry components for weather, tides, and moon forecasts.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"files": [
		"dist",
		"registry.json",
		"README.md",
		"LICENSE"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/build-registry.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"package": "svelte-package",
		"lint": "prettier --check .",
		"registry:build": "node scripts/build-registry.mjs",
		"test": "node scripts/build-registry.mjs && node --conditions=svelte --test scripts/*.test.mjs"
	},
