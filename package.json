{
	"name": "wxcn-svelte",
	"version": "0.1.0",
	"description": "shadcn-svelte registry components for weather, tides, and moon forecasts.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"files": [
		"dist",
		"registry.json",
		"README.md",
		"LICENSE"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/build-registry.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"package": "svelte-package",
		"lint": "prettier --check .",
		"registry:build": "node scripts/build-registry.mjs",
		"test": "node scripts/build-registry.mjs && node --conditions=svelte --test scripts/*.test.mjs"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/svelte": "^1.1.5",
		"@lucide/svelte": "^1.41.0",
		"@tabler/icons-svelte": "^3.46.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"package-manager-detector": "^1.8.0",
		"phosphor-svelte": "^3.1.0",
		"remixicon-svelte": "^0.0.5",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.1",
		"mdsx": "^0.0.7",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.6.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	}
}
