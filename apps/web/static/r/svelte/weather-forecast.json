      "type": "registry:component",
      "target": "icons/forecast-icons.svelte",
      "content": "<script lang=\"ts\">\n import IconPlaceholder from '$lib/components/icon-placeholder.svelte';\n import type { IconSet } from '$LIB$/data/types.js';\n let { name, class: className = 'size-5' }: { name: 'arrowUp' | 'arrowDown' | 'weather' | 'sun' | 'moon' | 'tide' | 'wind' | 'rain' | 'snow'; class?: string; iconSet?: IconSet } = $props();\n</script>\n{#if name === 'arrowUp'}\n <IconPlaceholder lucide=\"ArrowUpIcon\" tabler=\"IconArrowUp\" phosphor=\"ArrowUpIcon\" hugeicons=\"ArrowUp02Icon\" remixicon=\"RiArrowUpLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'arrowDown'}\n <IconPlaceholder lucide=\"ArrowDownIcon\" tabler=\"IconArrowDown\" phosphor=\"ArrowDownIcon\" hugeicons=\"ArrowDown02Icon\" remixicon=\"RiArrowDownLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'weather'}\n <IconPlaceholder lucide=\"CloudSunIcon\" tabler=\"IconCloud\" phosphor=\"CloudSunIcon\" hugeicons=\"SunCloud02Icon\" remixicon=\"RiCloudy2Line\" class={className} aria-hidden=\"true\" />\n{:else if name === 'sun'}\n <IconPlaceholder lucide=\"SunIcon\" tabler=\"IconSun\" phosphor=\"SunIcon\" hugeicons=\"Sun03Icon\" remixicon=\"RiSunLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'moon'}\n <IconPlaceholder lucide=\"MoonIcon\" tabler=\"IconMoon\" phosphor=\"MoonIcon\" hugeicons=\"Moon02Icon\" remixicon=\"RiMoonLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'tide'}\n <IconPlaceholder lucide=\"WavesIcon\" tabler=\"IconWavesElectricity\" phosphor=\"WavesIcon\" hugeicons=\"WaterfallUp01Icon\" remixicon=\"RiWaterFlashLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'wind'}\n <IconPlaceholder lucide=\"WindIcon\" tabler=\"IconWind\" phosphor=\"WindIcon\" hugeicons=\"WindPower02Icon\" remixicon=\"RiWindyLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'rain'}\n <IconPlaceholder lucide=\"CloudRainIcon\" tabler=\"IconCloudRain\" phosphor=\"CloudRainIcon\" hugeicons=\"CloudRainIcon\" remixicon=\"RiRainyLine\" class={className} aria-hidden=\"true\" />\n{:else if name === 'snow'}\n <IconPlaceholder lucide=\"SnowflakeIcon\" tabler=\"IconSnowflake\" phosphor=\"SnowflakeIcon\" hugeicons=\"SnowIcon\" remixicon=\"RiSnowyLine\" class={className} aria-hidden=\"true\" />\n{/if}\n"
