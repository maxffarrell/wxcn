{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "forecast-dashboard",
  "type": "registry:block",
  "description": "Weather and moon for Austin, with a separate coastal tide card.",
  "registryDependencies": [
    "./weather-forecast.json",
    "./moon-forecast.json",
    "./tide-forecast.json"
  ],
  "files": [
    {
      "path": "packages/svelte/src/components/wxcn/ForecastDashboard.svelte",
      "type": "registry:component",
      "target": "wxcn/ForecastDashboard.svelte",
      "content": "<script lang=\"ts\">\n\timport WeatherForecast from './WeatherForecast.svelte';\n\timport TideForecast from './TideForecast.svelte';\n\timport MoonForecast from './MoonForecast.svelte';\n\timport type {\n\t\tForecastType,\n\t\tIconSet,\n\t\tLocationInput,\n\t\tTideUnit,\n\t\tWeatherUnit\n\t} from '$LIB$/data/types.js';\n\n\tlet {\n\t\tinteractive = false,\n\t\ttimeZone,\n\t\ttype = 'summary',\n\t\tsize = 'default',\n\t\tdensity = 'comfortable',\n\t\tweatherUnit = 'fahrenheit',\n\t\twindUnit = 'mph',\n\t\ttideUnit = 'ft',\n\t\ticonType,\n\t\tanimatedWeatherBackground = false,\n\t\tshowTemperatureTrend = false,\n\t\tshowHighLow = false,\n\t\tcurrentWeather,\n\t\ttideLocation,\n\t\tlocation = {\n\t\t\tlabel: 'Austin, TX',\n\t\t\tlatitude: 30.2672,\n\t\t\tlongitude: -97.7431,\n\t\t\ttimeZone: 'America/Chicago'\n\t\t}\n\t}: {\n\t\tinteractive?: boolean;\n\t\ttimeZone?: string;\n\t\ttype?: ForecastType;\n\t\tsize?: 'sm' | 'default' | 'lg';\n\t\tdensity?: 'compact' | 'comfortable';\n\t\tweatherUnit?: WeatherUnit;\n\t\twindUnit?: 'mph' | 'km/h' | 'm/s' | 'knots';\n\t\ttideUnit?: TideUnit;\n\t\ticonType?: IconSet;\n\t\tanimatedWeatherBackground?: boolean;\n\t\tshowTemperatureTrend?: boolean;\n\t\tshowHighLow?: boolean;\n\t\tcurrentWeather?: import('$LIB$/data/types.js').CurrentWeather | null;\n\t\tlocation?: LocationInput;\n\t\ttideLocation?: LocationInput;\n\t} = $props();\n</script>\n\n<div class=\"@container/dashboard w-full\">\n\t<div\n\t\tclass=\"grid items-start gap-4 @min-[38rem]/dashboard:grid-cols-2 @min-[52rem]/dashboard:grid-cols-3\"\n\t>\n\t\t<div class=\"min-w-0 @min-[38rem]/dashboard:col-span-2 @min-[52rem]/dashboard:col-span-1\">\n\t\t\t<WeatherForecast\n\t\t\t\t{interactive}\n\t\t\t\t{timeZone}\n\t\t\t\t{type}\n\t\t\t\t{size}\n\t\t\t\t{density}\n\t\t\t\tunit={weatherUnit}\n\t\t\t\t{windUnit}\n\t\t\t\t{iconType}\n\t\t\t\t{location}\n\t\t\t\tanimatedBackground={animatedWeatherBackground}\n\t\t\t\t{showTemperatureTrend}\n\t\t\t\t{showHighLow}\n\t\t\t\t{currentWeather}\n\t\t\t/>\n\t\t</div>\n\t\t<TideForecast\n\t\t\t{interactive}\n\t\t\t{timeZone}\n\t\t\t{type}\n\t\t\t{size}\n\t\t\t{density}\n\t\t\tunit={tideUnit}\n\t\t\t{iconType}\n\t\t\tlocation={tideLocation}\n\t\t/>\n\t\t<MoonForecast {interactive} {timeZone} {type} {size} {density} {iconType} {location} />\n\t</div>\n</div>\n"
    }
  ]
}
