{
	"name": "wxcn-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.20.0",
	"scripts": {
		"dev": "pnpm docs:build && pnpm --filter @wxcn/web dev",
		"build": "pnpm docs:build && pnpm --filter @wxcn/web build && node tooling/deploy/link-worker.ts",
		"preview": "pnpm --filter @wxcn/web preview",
		"check": "pnpm --filter @wxcn/core check && pnpm check:svelte && pnpm check:react && pnpm check:vue",
		"lint": "prettier --check .",
		"registry:build": "node tooling/registry/build.ts",
		"dns-aid:check": "node scripts/dns-aid-check.ts",
		"test": "pnpm registry:build && node --conditions=svelte --test scripts/*.test.ts",
		"test:consumer": "pnpm registry:build && node scripts/consumer.test-build.ts",
		"docs:build": "pnpm registry:build && pnpm --filter @wxcn/web exec node scripts/build-docs.ts",
		"dev:react": "pnpm --filter @wxcn/preview-react dev",
		"build:react": "pnpm --filter @wxcn/preview-react build",
		"test:react": "tsx --tsconfig packages/react/tsconfig.json --test packages/react/test/react.test.tsx",
		"test:consumer:react": "pnpm registry:build && node scripts/react-consumer.test-build.ts",
		"dev:vue": "pnpm --filter @wxcn/preview-vue dev",
		"build:vue": "pnpm --filter @wxcn/preview-vue build",
		"test:consumer:vue": "pnpm registry:build && node scripts/vue-consumer.test-build.ts",
		"test:vue": "pnpm --filter @wxcn/preview-vue test:ssr",
		"check:svelte": "pnpm docs:build && pnpm --filter @wxcn/svelte check && pnpm --filter @wxcn/web check",
		"check:react": "pnpm --filter @wxcn/react check && pnpm --filter @wxcn/preview-react check",
		"check:vue": "pnpm --filter @wxcn/vue check && pnpm --filter @wxcn/preview-vue check",
		"preinstall": "node scripts/check-node.ts"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"prettier": "3.10.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn": "4.23.0",
		"shadcn-svelte": "1.8.1",
		"svelte": "5.57.3",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"wrangler": "4.162.0"
	},
	"engines": {
		"node": "^26.12.1"
	}
}
