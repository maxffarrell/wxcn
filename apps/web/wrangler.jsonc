{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "wxcn",
	"account_id": "ecb6cf90208469786cff01f71ef0a8cd",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "wxcn.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"preview": {
			"name": "wxcn-preview",
			"routes": [],
			"workers_dev": true,
			"assets": {
				"directory": "./dist/client",
				"binding": "ASSETS"
			}
		}
	}
}
